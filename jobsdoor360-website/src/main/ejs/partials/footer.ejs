<!-- The Bootstrap Modal -->
<div
  class="modal fade"
  id="myModal"
  tabindex="-1"
  aria-labelledby="exampleModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">
          What Can We Improve on Our Website?
        </h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <textarea
          id="feedback"
          class="form-control"
          placeholder="Your feedback..."
        ></textarea>
        <input
          type="text"
          id="phoneNumber"
          class="form-control"
          placeholder="Your phone number..."
        />
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          Close
        </button>
        <button id="submitFeedback" class="btn btn-primary">Submit</button>
      </div>
    </div>
  </div>
</div>

<!-- encryption decryption methods-->
<script>
  function toBase64Url(uint8Array) {
    let binary = "";
    for (let b of uint8Array) binary += String.fromCharCode(b);
    return btoa(binary)
      .replace(/\+/g, "-")
      .replace(/\//g, "_")
      .replace(/=+$/, "");
  }

  function fromBase64Url(base64Url) {
    base64Url = base64Url
      .replace(/-/g, "+")
      .replace(/_/g, "/");

    // pad length to divide by 4
    while (base64Url.length % 4) base64Url += "=";

    const binary = atob(base64Url);
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    return bytes;
  }

  async function encryptData(jsonStr, keyText = "1234567890123456") {
    const enc = new TextEncoder();
    const iv = crypto.getRandomValues(new Uint8Array(12));

    const key = await crypto.subtle.importKey(
      "raw",
      enc.encode(keyText),
      "AES-GCM",
      false,
      ["encrypt"]
    );

    const encrypted = await crypto.subtle.encrypt(
      { name: "AES-GCM", iv },
      key,
      enc.encode(jsonStr)
    );

    const cipherBytes = new Uint8Array(encrypted);

    // Combine IV + ciphertext
    const combined = new Uint8Array(iv.length + cipherBytes.length);
    combined.set(iv, 0);
    combined.set(cipherBytes, iv.length);

    return toBase64Url(combined); // <-- URL safe
  }

  async function decryptData(urlSafeStr, keyText = "1234567890123456") {
    const enc = new TextEncoder();
    const bytes = fromBase64Url(urlSafeStr);

    const iv = bytes.slice(0, 12);
    const encrypted = bytes.slice(12);

    const key = await crypto.subtle.importKey(
      "raw",
      enc.encode(keyText),
      "AES-GCM",
      false,
      ["decrypt"]
    );

    const decrypted = await crypto.subtle.decrypt(
      { name: "AES-GCM", iv },
      key,
      encrypted
    );

    return new TextDecoder().decode(decrypted);
  }

  function getLoggedInUserName(){
    return localStorage.getItem("username");
  }

</script>

<script type="module" src="/staticfiles/db/dbconfig.js"></script>
<script type="module" src="/staticfiles/script.js"></script>
<script type="module">
  // Keeps the signed-in user's email and name in localStorage for the pages
  // that read them (staticfiles/script.js, getLoggedInUserName()).
  // The header no longer has Login / Sign up / Logout buttons; "Log out" is
  // in the footer and handled by /staticfiles/mainfiles/platform/layout.js.
  window.auth.onAuthStateChanged(async (user) => {
    if (!user) return;
    localStorage.setItem("email", user.email);
    let username = user.displayName;
    if (!username) {
      try {
        const docSnap = await getDoc(doc(db, "lead", user.email));
        if (docSnap.exists()) {
          username = docSnap.data().full_name || user.email; // fall back to email if full_name is missing
        }
      } catch (error) {
        console.error("Error fetching username:", error);
        username = user.email;
      }
    }
    localStorage.setItem("username", username);
  });
</script>

