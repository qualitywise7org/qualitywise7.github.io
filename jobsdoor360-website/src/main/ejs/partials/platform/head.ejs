<%#
  Shared <head> for the platform pages (homepage, Smart Decisions, Findme,
  Career Counselling, Utility Tools).

  Usage, inside <head>:
    include('<relative path>/partials/platform/head.ejs', {
          title: "...",
          description: "...",
          canonical: "https://jobsdoor360.in/<path>/",
          styles: ["/staticfiles/mainfiles/<feature>/style.css"]   // optional, page-only CSS
        })

  Shared CSS (/staticfiles/mainfiles/platform/style.css) loads first, then
  the page's own CSS, so a page can only add to or override the shared look.
-%>
<%_ const pageStyles = typeof styles !== "undefined" ? styles : []; _%>
<meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <meta name="description" content="<%= description %>" />
    <link rel="canonical" href="<%= canonical %>" />
    <meta name="google-adsense-account" content="ca-pub-2075086355753452" />
    <link rel="icon" href="/fevicon.ico" type="profile" />
    <link rel="stylesheet" href="/staticfiles/style.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous" />
    <link rel="stylesheet" href="/staticfiles/mainfiles/platform/style.css?v=<%= platform_version %>" />
<%_ pageStyles.forEach((href) => { _%>
    <link rel="stylesheet" href="<%= href %>?v=<%= platform_version %>" />
<%_ }) _%>
    <!-- Google Analytics (same property as the rest of the site) + Tag Manager -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1JQVXS3B5L"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-1JQVXS3B5L");
    </script>
    <script>(function (w, d, s, l, i) { w[l] = w[l] || []; w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" }); var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != "dataLayer" ? "&l=" + l : ""; j.async = true; j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl; f.parentNode.insertBefore(j, f); })(window, document, "script", "dataLayer", "GTM-MFBK5637");</script>
    <!-- Sends a GA event for every button and link click -->
    <script src="/staticfiles/mainfiles/platform/ga.js?v=<%= platform_version %>" defer></script>
