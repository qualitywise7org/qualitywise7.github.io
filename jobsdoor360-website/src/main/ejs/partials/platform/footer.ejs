<%#
  Bottom of <body> for the platform pages: the site footer + widget
  (partials/layout/site-footer.ejs, shared with every other page) and the
  scripts every platform page needs.

  Usage, after </main>:
    include('<relative path>/partials/platform/footer.ejs')
    ...then the page's own <script> tags.
-%>
<div id="jd-footer-slot">
<%- include('../layout/site-footer.ejs') %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
    <script src="https://kit.fontawesome.com/f6b356be29.js" crossorigin="anonymous"></script>
    <!-- back-to-top button + footer "Log out" link (markup above) -->
    <script type="module" src="/staticfiles/mainfiles/platform/layout.js?v=<%= platform_version %>"></script>
