<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../../../partials/platform/head.ejs', {
      title: "Merge images: join JPG and PNG files into one image | JobsDoor360",
      description: "Join two or more JPG, PNG or WEBP images into one picture in your browser. Choose top-to-bottom or side-by-side. Nothing is uploaded.",
      canonical: "https://jobsdoor360.in/tools/merge-images/",
      styles: ["/staticfiles/mainfiles/tools/style.css"],
    }) -%>
  </head>
  <body class="sd-body jd-tool-page jd-c-mimg" data-ga-module="merge-images" data-tool="merge-images">
    <%- include('../../../partials/platform/navbar.ejs', { path: "/tools/merge-images/" }) -%>
    <main id="main">
      <header class="jd-tool-hero" data-ga-section="tool_hero">
