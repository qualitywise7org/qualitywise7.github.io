    <script src="/staticfiles/mainfiles/tools/common.js?v=<%= platform_version %>"></script>
    <script src="/staticfiles/mainfiles/tools/pdf-to-word/script.js?v=<%= platform_version %>"></script>
    <script src="/staticfiles/mainfiles/tools/script.js?v=<%= platform_version %>"></script>
