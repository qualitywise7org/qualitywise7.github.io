<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../../../partials/platform/head.ejs', {
      title: "PDF to Word: extract editable text from a PDF | JobsDoor360",
      description: "Turn a text-based PDF into an editable Word DOCX file in your browser. Add one or more PDFs. Nothing is uploaded.",
      canonical: "https://jobsdoor360.in/tools/pdf-to-word/",
      styles: ["/staticfiles/mainfiles/tools/style.css"],
    }) -%>
  </head>
  <body class="sd-body jd-tool-page jd-c-p2w" data-ga-module="pdf-to-word" data-tool="pdf-to-word">
    <%- include('../../../partials/platform/navbar.ejs', { path: "/tools/pdf-to-word/" }) -%>
    <main id="main">
      <header class="jd-tool-hero" data-ga-section="tool_hero">
        <div class="sd-wrap">
          <nav class="sd-crumbs" aria-label="Breadcrumb" data-ga-section="breadcrumb"><a href="/" data-ga-event="nav_click" data-ga-name="breadcrumb_home">Home</a><span>/</span><a href="/tools/" data-ga-event="nav_click" data-ga-name="breadcrumb_utility_tools">Utility Tools</a><span>/</span><span aria-current="page" style="opacity:1;margin:0">PDF to Word</span></nav>
          <h1>PDF to Word</h1>
          <p>Get editable text from a PDF in a Word file.</p>
        </div>
      </header>
      <div class="sd-wrap" style="padding-bottom: 0" data-ga-section="tool_intro">
        <p class="sd-note" style="text-align:center;margin:0">Best for normal text PDFs. Scanned PDFs are pictures, so they don't contain text to pull out.</p>
